CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_xiaomi_ax9000=y

# Build only the selected AX9000 image and firmware artifacts.
CONFIG_TARGET_MULTI_PROFILE=y
# CONFIG_TARGET_ALL_PROFILES is not set
# CONFIG_ALL_NONSHARED is not set
# CONFIG_IB is not set
# CONFIG_IB_STANDALONE is not set

# Keep factory/sysupgrade images, skip formats not needed for AX9000.
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=n
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y

# Web UI defaults.
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_nginx-mod-luci=y
CONFIG_PACKAGE_nginx-ssl=y
# CONFIG_PACKAGE_luci-nginx is not set
# CONFIG_PACKAGE_uhttpd is not set

# AX9000 NSS/LAN stack.
CONFIG_PACKAGE_kmod-qca-ssdk=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_nss-firmware-ipq807x=y
CONFIG_PACKAGE_kmod-phylink=y
