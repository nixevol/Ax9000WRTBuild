  "webServers": [
    {
      "id": "Nginx",
      "title": "Nginx",
      "description": "Nginx + LuCI",
      "packages": ["nginx-mod-luci", "nginx-ssl"],
      "httpsPackages": [],
      "supportsHttps": true
    },
    {
      "id": "Uhttpd",
      "title": "uHTTPd",
      "description": "OpenWrt 默认轻量 Web 服务",
      "packages": ["uhttpd", "uhttpd-mod-ubus"],
      "httpsPackages": ["libustream-mbedtls", "px5g-mbedtls"],
      "supportsHttps": true
    },
    {
      "id": "Lighttpd",
      "title": "Lighttpd",
      "description": "Lighttpd + CGI LuCI",
      "packages": ["lighttpd", "lighttpd-mod-cgi", "lighttpd-mod-mbedtls", "lighttpd-mod-redirect"],
      "httpsPackages": [],
      "supportsHttps": false
    }
  ],
  "features": [
    {
      "id": "docker",
      "title": "Docker",
      "description": "容器运行环境与 LuCI 管理",
      "packages": ["dockerd", "docker", "luci-app-dockerman"],
