  "firewallBackends": [
    {
      "id": "firewall4",
      "title": "Firewall4 / Nftables",
      "description": "OpenWrt 25.12 默认防火墙",
      "packages": ["firewall4"],
      "disabledPackages": ["firewall", "iptables-zz-legacy"],
      "requiresKernelIpv6": true
