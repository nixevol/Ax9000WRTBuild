#!/bin/sh /etc/rc.common

USE_PROCD=1
START=91
STOP=9

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/ax900-led-control
	procd_set_param respawn 5 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	if service_running; then
		touch /var/run/ax900-led.reload
	else
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger ax900-hardware
}
