#!/bin/sh

. /usr/share/libubox/jshn.sh

status() {
	local maximum=0 hottest="" value type device pwm=-1 rpm=-1
	for sensor in /sys/class/thermal/thermal_zone*/temp; do
		[ -r "$sensor" ] || continue
		value="$(cat "$sensor" 2>/dev/null)"
		case "$value" in *[!0-9]*|'') continue ;; esac
		if [ "$value" -gt "$maximum" ]; then
			maximum="$value"
			type="${sensor%/temp}/type"
			hottest="$(cat "$type" 2>/dev/null)"
		fi
	done
	for device in /sys/class/hwmon/hwmon*; do
		[ -r "$device/name" ] || continue
		case "$(cat "$device/name")" in
			emc2301|emc2305)
				[ -r "$device/pwm1" ] && pwm="$(cat "$device/pwm1" 2>/dev/null)"
				[ -r "$device/fan1_input" ] && rpm="$(cat "$device/fan1_input" 2>/dev/null)"
				break
			;;
		esac
	done
	json_init
	json_add_int temperature "$maximum"
	json_add_string hottest "$hottest"
	json_add_int pwm "${pwm:--1}"
	json_add_int rpm "${rpm:--1}"
	json_dump
}

case "$1:$2" in
	list:)
		echo '{ "status": {} }'
	;;
	call:status)
		status
	;;
	*)
		exit 1
	;;
esac
